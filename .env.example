# =================================================================
# Jerry's Garden Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to Git/GitHub.
# =================================================================

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# Cloudinary Storage Configuration (Required for photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email API Configuration for Customer OTP Verification (AgentMail HTTPS API)
# Free tier: 3 inboxes, 3,000 emails/month, 100 emails/day.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
EMAIL_FROM_NAME=Jame Bouquets

# MongoDB Atlas Database Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=jerrysgarden

# Frontend / Application URLs
FRONTEND_URL=https://jamebouquets.vercel.app,https://jamebouquets.in,https://www.jamebouquets.in
APP_URL=

# Server-side authentication (required before launch)
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=


# Delhivery: exact registered pickup warehouse name, not a street address.
DELHIVERY_API_TOKEN=
DELHIVERY_ENV=staging
DELHIVERY_PICKUP_LOCATION=
# Enable only after testing your account; creates real shipments in production.
DELHIVERY_DISPATCH_ENABLED=false

# Shadowfax inbound callback secrets: generate two independent random 32+ character values.
SHADOWFAX_WEBHOOK_SECRET=
SHADOWFAX_STAGING_WEBHOOK_SECRET=
# Optional staging read-only tracking token when production is active.
SHADOWFAX_STAGING_API_TOKEN=
