# =================================================================
# Jerry's Garden Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to Git/GitHub.
# =================================================================

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# Cloudinary Storage Configuration (Required for photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email API Configuration for Customer OTP Verification (AgentMail HTTPS API)
# Free tier: 3 inboxes, 3,000 emails/month, 100 emails/day.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
EMAIL_FROM_NAME=Jerry's Garden

# MongoDB Atlas Database Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=jerrysgarden

# Frontend / Application URLs
FRONTEND_URL=https://jerrys-garden.vercel.app
APP_URL=
